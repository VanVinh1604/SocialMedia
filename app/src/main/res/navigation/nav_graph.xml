        <argument
            android:name="conversationId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="userId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="userName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="userAvatar"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
