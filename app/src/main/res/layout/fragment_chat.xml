<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar giống như trước -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:padding="8dp"
        android:background="@drawable/btn_background">

        <!-- Back -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Back"/>

        <!-- Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_toEndOf="@id/ivBack"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:src="@drawable/image_avata_user"/>

        <!-- Username -->
        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivAvatar"
            android:layout_marginStart="8dp"
            android:text="User Name"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- User Status -->
        <TextView
            android:id="@+id/tvUserStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvUserName"
            android:layout_toEndOf="@id/ivAvatar"
            android:layout_marginStart="8dp"
            android:text="Online"
            android:textSize="12sp"
            android:textColor="#888888"/>

        <!-- Call -->
        <ImageView
            android:id="@+id/ivCall"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_call"
            android:layout_toStartOf="@id/ivVideoCall"
            android:layout_centerVertical="true"
            android:padding="4dp"/>

        <!-- Video Call -->
        <ImageView
            android:id="@+id/ivVideoCall"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_video_call"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="4dp"/>
    </RelativeLayout>

    <!-- RecyclerView hiển thị tin nhắn -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

    <!-- Input Bar -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/btn_background"
        android:gravity="center_vertical">

        <!-- Sticker -->
        <ImageView
            android:id="@+id/ivSticker"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_smile"
            android:padding="4dp"
            android:contentDescription="Sticker"/>

        <!-- EditText với nút gửi nằm bên phải -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Message..."
                android:background="@drawable/rounded_input_bg"
                android:paddingStart="8dp"
                android:paddingEnd="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:inputType="textMultiLine"/>

            <!-- Nút gửi -->
            <ImageView
                android:id="@+id/ivSend"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_share"
                android:contentDescription="Send"
                android:padding="4dp"/>
        </RelativeLayout>

        <!-- Mic -->
        <ImageView
            android:id="@+id/ivMic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_mic"
            android:padding="4dp"
            android:contentDescription="Mic"/>

        <TextView
            android:id="@+id/tvRecordingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@android:color/black"
            android:visibility="gone"
            android:layout_marginStart="8dp"/>

        <!-- File -->
        <ImageView
            android:id="@+id/ivFile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_file"
            android:padding="4dp"
            android:contentDescription="File"/>

        <!-- Camera -->
        <ImageView
            android:id="@+id/ivCamera"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_camera_mess"
            android:padding="4dp"
            android:contentDescription="Camera"/>
    </LinearLayout>
</LinearLayout>
