<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/storyRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/currentUserContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <FrameLayout
        android:id="@+id/nextUserContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <!-- ViewPager2 full màn hình -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/storyViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false" />

    <!-- ProgressBar overlay -->
<!--    <ProgressBar-->
<!--        android:id="@+id/storyProgressBar"-->
<!--        style="?android:attr/progressBarStyleHorizontal"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="4dp"-->
<!--        android:max="10000"-->
<!--        android:progress="0"-->
<!--        android:indeterminate="false"-->
<!--        android:layout_gravity="top"-->
<!--        android:progressDrawable="@drawable/story_progress_drawable" />-->
    <LinearLayout
        android:id="@+id/storyProgressContainer"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:orientation="horizontal"
        android:showDividers="middle"
        android:divider="@android:color/transparent"
        android:dividerPadding="4dp"
        android:layout_marginTop="8dp" />


    <!--    <androidx.recyclerview.widget.RecyclerView-->
<!--        android:id="@+id/progressRecycler"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="4dp"-->
<!--        android:layout_gravity="top"-->
<!--        android:padding="4dp"-->
<!--        android:clipToPadding="false"-->
<!--        android:clipChildren="false" />-->



    <!-- Top bar overlay -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@android:color/transparent">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgUserAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/default_avatar" />

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="username"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_more"
            android:tint="@android:color/white"
            android:padding="4dp" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_close"
            android:tint="@android:color/white"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Bottom reply overlay -->
    <LinearLayout
        android:id="@+id/bottomReplyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#CC000000"
        android:layout_gravity="bottom">

        <EditText
            android:id="@+id/etReplyMessage"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_reply_edittext"
            android:hint="Trả lời..."
            android:textColorHint="#AAAAAA"
            android:textColor="@android:color/white"
            android:paddingHorizontal="16dp" />

        <ImageView
            android:id="@+id/btnSendReply"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_favorite_red"
            android:tint="@android:color/white" />
    </LinearLayout>


</FrameLayout>
