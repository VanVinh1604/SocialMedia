<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="200dp"
    android:layout_marginEnd="10dp"
    android:clipToOutline="true"
    android:background="@drawable/bg_story_card">

    <!-- Ảnh story nền -->
    <ImageView
        android:id="@+id/imgStoryBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/image_person" />

    <!-- Gradient mờ dưới -->
    <View
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@drawable/story_gradient_bottom" />

    <!-- Avatar nhỏ góc dưới trái -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imgAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/image_avata_user"
        app:civ_border_width="3dp"
        app:civ_border_color="@color/story_unseen_border"
        android:scaleType="centerCrop" />

</FrameLayout>
