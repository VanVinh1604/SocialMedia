<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="35dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Comment con -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Avatar người reply -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgReplyAvatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/image_avata_user"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <!-- Tên + nhãn tác giả + ngôi sao -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvReplyUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvReplyAuthorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tác giả"
                    android:textColor="@android:color/holo_red_dark"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/imgReplyStar"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Nội dung reply + like -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvReplyContent"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Nội dung reply"
                    android:textSize="13sp"/>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/imgLikeReply"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_favorite"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvReplyLikeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Thời gian + nút trả lời -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvReplyTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 phút trước"
                    android:textSize="12sp"
                    android:textColor="#888888"/>

                <TextView
                    android:id="@+id/btnReplyToReply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trả lời"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
