<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <!-- ĐÃ CHỈNH SỬA -->
    <TextView
        android:id="@+id/tvEdited"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ĐÃ CHỈNH SỬA"
        android:textColor="#0000FF"
        android:textStyle="bold"
        android:textSize="11sp"
        android:visibility="gone"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvMessage"/>

    <!-- Bong bóng tin nhắn -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="260dp"
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:background="@drawable/bg_message_outgoing"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvEdited"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutReply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/bg_reply_box"
        android:visibility="gone"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvEdited">

        <TextView
            android:id="@+id/tvReplyUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên người gửi"
            android:textStyle="bold"
            android:textColor="#555555"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvReplyContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nội dung được trả lời..."
            android:textColor="#444444"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:maxWidth="260dp"
        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@id/tvMessage"
        app:layout_constraintEnd_toEndOf="@id/tvMessage" />


    <!-- TIME -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:31 AM"
        android:textSize="11sp"
        android:textColor="#CCCCCC"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHistory"
        app:layout_constraintEnd_toEndOf="@id/tvMessage" />

</androidx.constraintlayout.widget.ConstraintLayout>
