<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/image_person"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background_gray"
            android:padding="3dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/txtUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h ago"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 🔸 Giữ lại nút menu (đã bỏ Follow) -->
        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- 🔹 Nội dung bài viết -->
    <TextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is an example post content. 😊"
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPost"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        android:src="@drawable/image_backgroud"
        app:shapeAppearanceOverlay="@style/roundedCorner16dp"
        android:layout_marginBottom="8dp"/>


    <!-- 🔹 Nếu bạn bè cũng thích bài viết -->
    <TextView
        android:id="@+id/tvFriendLiked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nguyễn Văn A và 2 người bạn khác đã thích bài viết này"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <!-- 🔹 Thanh tương tác -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:paddingVertical="4dp">

        <!-- 🔸 Bên trái: Like - Comment - Share + số lượt -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Like -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/ivLike"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_favorite" />

                <TextView
                    android:id="@+id/tvLikesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123"
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Comment -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/ivComment"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_comment" />

                <TextView
                    android:id="@+id/tvCommentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24"
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Share -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivShare"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_share" />

                <TextView
                    android:id="@+id/tvShareCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 🔸 Bên phải: nút Save -->
        <ImageView
            android:id="@+id/ivSave"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_save"
            android:tint="#666666"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
