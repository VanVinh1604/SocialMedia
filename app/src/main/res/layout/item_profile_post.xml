<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1dp"> <!-- Thêm padding 1dp để tạo khoảng cách giữa các ảnh -->

    <!--
        Đây là phần quan trọng:
        Sử dụng app:layout_constraintDimensionRatio="1:1"
        để tạo ra một ô vuông hoàn hảo, bất kể chiều rộng là bao nhiêu.
        Đây chính là cách Instagram hiển thị lưới ảnh vuông.
    -->
    <ImageView
        android:id="@+id/iv_post_thumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#EEEEEE" /> <!-- Màu nền placeholder khi ảnh đang tải -->

</androidx.constraintlayout.widget.ConstraintLayout>

