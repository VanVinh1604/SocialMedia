<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <!-- Avatar bên trái -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/image_avata_user"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="6dp"/>

    <!-- Bubble ảnh ngay bên phải avatar, cùng đáy -->
    <FrameLayout
        android:id="@+id/imageBubble"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_message_incoming"
        android:padding="2dp"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        app:layout_constraintBottom_toBottomOf="@id/ivAvatar">

        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/bg_rounded_image" />
    </FrameLayout>

    <!-- Thời gian nằm bên phải ảnh, cùng hàng -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:30 AM"
        android:textSize="11sp"
        android:textColor="#888888"
        app:layout_constraintStart_toEndOf="@id/imageBubble"
        app:layout_constraintBottom_toBottomOf="@id/imageBubble"
        android:layout_marginStart="6dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
