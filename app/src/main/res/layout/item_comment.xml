<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Comment chính -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Avatar người comment -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgUserAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/image_avata_user"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <!-- Tên + nhãn + ngôi sao -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvAuthorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tác giả"
                    android:textColor="@android:color/holo_red_dark"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/imgCurrentUserStar"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Nội dung comment + like -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <!-- Nội dung comment -->
                <TextView
                    android:id="@+id/tvCommentContent"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Nội dung comment"
                    android:textSize="14sp"/>

                <!-- Spacer để đẩy tim sang phải -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp"/>

                <!-- Like tim nằm trên số lượt -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="8dp"> <!-- Khoảng cách với biên phải -->

                    <ImageView
                        android:id="@+id/imgLikeComment"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_favorite"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvLikeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>


            <!-- Thời gian + reply -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 phút trước"
                    android:textSize="12sp"
                    android:textColor="#888888"/>

                <TextView
                    android:id="@+id/tvReply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trả lời"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Comment con (Reply) -->
    <LinearLayout
        android:id="@+id/layoutReplies"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="4dp">

        <!-- Comment con đầu tiên -->
        <LinearLayout
            android:id="@+id/layoutFirstReply"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgReplyAvatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/image_avata_user"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvReplyContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nội dung reply"
                android:textSize="13sp"
                android:textColor="#555555"/>
        </LinearLayout>

        <!-- TextView xem thêm replies -->
        <TextView
            android:id="@+id/tvSeeMoreReplies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bạn có muốn xem 24 câu trả lời khác"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_marginTop="2dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvHideReplies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ẩn tất cả câu trả lời"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_marginTop="2dp"
            android:visibility="gone"/>

    </LinearLayout>
</LinearLayout>
